[Unit]
Description=Vault meta grantee-axis probe (dev and prod)
After=network.target
# Backstop for the paths the probe cannot report itself: it never started,
# it died before reaching its own alarm helper, or its alarm delivery
# failed. Install orbi-probe-failed@.service and its script BEFORE
# enabling this unit.
OnFailure=orbi-probe-failed@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/orbi/vault-meta-grantee-axis-probe.env
ExecStart=/usr/local/bin/vault-meta-grantee-axis-probe.sh
StandardOutput=journal
StandardError=journal
