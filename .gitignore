.reserved-terms

# Agent tooling scratch space. These directories hold local agent
# configuration and worktrees (git worktrees are created inside .claude/),
# so they can contain full copies of the repository. Keep them untracked so
# a blanket "git add -A" cannot commit thousands of stray files.
.claude/
.mcp/
