[Unit]
Description=ORBI live forward-fill — publishes BTC and composite rates every minute
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AIHUB/REPOS/orangerails/orbi
ExecStart=/home/ubuntu/.bun/bin/bun run scripts/forward-fill.ts
Restart=on-failure
RestartSec=15
StandardOutput=append:/tmp/orbi-forward-fill.log
StandardError=append:/tmp/orbi-forward-fill.log

# Resource guards — match what forward-fill actually uses
MemoryMax=512M
TasksMax=64

# Allow read of /opt/bb-support/.env (mode 640 root:ubuntu)
ProtectSystem=full
PrivateTmp=no
ReadOnlyPaths=/opt/bb-support
ReadWritePaths=/tmp /home/ubuntu/AIHUB/REPOS/orangerails

[Install]
WantedBy=multi-user.target
