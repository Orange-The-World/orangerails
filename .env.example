#
# Orange Rails — sample environment file.
#
# Copy to `.env` (gitignored) and fill in real values for your local
# Supabase project. Production deployments should set these via the
# hosting platform's secret/env-var UI and never commit real values.
#
# The three VITE_ values are embedded into the client bundle at build
# time — only commit values that are intentionally public (the Supabase
# publishable / anon key is designed to be public, see Supabase docs).
#

# ─── Supabase projects (canonical refs) ─────────────────────────────
#
# These project refs are stable. The values shipped here are correct
# for the BitBooks-owned Supabase projects after the 2026-05-13 cutover
# off the self-hosted db.orangerails.com instance.
#
#   orangerails-dev   → fzwmnzmtqidumdqjdddz.supabase.co
#   orangerails-prod  → lcdicqalreskibdfxkzb.supabase.co
#
# DO NOT use the older `tbjffcasjkhhlmsqnjim` ref — it was the
# pre-cutover self-hosted project ref and is no longer in service.
# See supabase/config.toml for the linked dev project_id.
#

# Dev defaults (for local development against orangerails-dev)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://fzwmnzmtqidumdqjdddz.supabase.co
VITE_SUPABASE_PROJECT_ID=fzwmnzmtqidumdqjdddz
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://fzwmnzmtqidumdqjdddz.supabase.co
